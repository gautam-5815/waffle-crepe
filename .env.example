# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL used for canonical links, sitemap and share images.
# Use the vercel.app preview URL until the real domain points at Vercel.
NEXT_PUBLIC_SITE_URL=https://wafflencrepe.com

# Long random string that protects POST /api/revalidate (used by the WooCommerce webhook).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=
